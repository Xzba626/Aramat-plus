# AROMAT PLUS / Aramat Plus ERP
# Copy to .env and fill in values. Never commit real secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker Compose:
DATABASE_URL="postgresql://aromat:aromat@localhost:5432/aromat_plus?schema=public"
DIRECT_URL="postgresql://aromat:aromat@localhost:5432/aromat_plus?schema=public"

# Production example (Contabo / VPS):
# DATABASE_URL="postgresql://aromat:STRONG_PASSWORD@127.0.0.1:5432/aromat_plus?schema=public"
# DIRECT_URL="postgresql://aromat:STRONG_PASSWORD@127.0.0.1:5432/aromat_plus?schema=public"

# ── Auth.js (required) ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Public URL of this deployment (no trailing slash). Must match how users open the app.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Production: https://your-domain.or.ip:3000 — never leave localhost on a VPS

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Aramat Plus"
NODE_ENV=development
# Production: NODE_ENV=production

# ── Storage (optional) ────────────────────────────────────────────────────────
# STORAGE_PROVIDER=auto
# BLOB_READ_WRITE_TOKEN=

# ── Seed note ─────────────────────────────────────────────────────────────────
# npx prisma db seed  → safe upsert (does NOT wipe sales)
# Default users: see DEPLOYMENT.md
