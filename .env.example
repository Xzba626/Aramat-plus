# AROMAT PLUS / Aramat Plus ERP
# Copy to .env and fill in values. Never commit real secrets.

# Database — local Docker Compose:
DATABASE_URL="postgresql://aromat:aromat@localhost:5432/aromat_plus?schema=public"
DIRECT_URL="postgresql://aromat:aromat@localhost:5432/aromat_plus?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Production: set AUTH_URL/NEXTAUTH_URL to https://your-domain (never localhost)

# Storage: auto | local | vercel-blob
# STORAGE_PROVIDER=auto
# BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_APP_NAME="Aramat Plus"
NODE_ENV=development
