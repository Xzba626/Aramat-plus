# AROMAT PLUS ERP
# Copy to .env and fill in values

# PostgreSQL — Docker Compose (recommended for local):
DATABASE_URL="postgresql://aromat:aromat@localhost:5432/aromat_plus?schema=public"

# Or native local Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aromat_plus?schema=public"

# Or Neon (optional shared remote DB — not required for local Docker):
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate a long random secret
AUTH_SECRET="replace-with-a-long-random-secret"

# Canonical app URL for Auth.js redirects.
# On the same PC: http://localhost:3000
# From phone on LAN: use the PC LAN IP, e.g. http://192.168.43.52:3000
# Then restart: npm run dev
AUTH_URL="http://192.168.43.52:3000"
NEXTAUTH_URL="http://192.168.43.52:3000"
# trustHost is enabled in src/lib/auth.ts — Host header is trusted in dev

# App
NEXT_PUBLIC_APP_NAME="Aromat Plus"
