# AROMAT PLUS ERP
# Copy to .env and fill in values

# PostgreSQL — Docker Compose (recommended for local):
DATABASE_URL="postgresql://neondb_owner:npg_HyIziB7OAeJ5@ep-wispy-firefly-asz7fusz.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:npg_HyIziB7OAeJ5@ep-wispy-firefly-asz7fusz.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Or native local Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aromat_plus?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aromat_plus?schema=public"

# Neon (production):
# DATABASE_URL = pooled (...-pooler.neon.tech...) for the app
# DIRECT_URL   = non-pooler (ep-xxxx....neon.tech, NO "-pooler") for migrate + $transaction
# If transfers/sales throw P2028, put the non-pooler URL in DATABASE_URL too (or only use DIRECT).
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASS@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate a long random secret
AUTH_SECRET="replace-with-a-long-random-secret"

# Canonical app URL for Auth.js redirects.
# Local PC: http://localhost:3000
# Phone on LAN: http://192.168.x.x:3000
# Vercel production: https://YOUR-PROJECT.vercel.app
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# trustHost is enabled — Host header is trusted

# ── Vercel (Production) — set in Project → Settings → Environment Variables ──
# DATABASE_URL   = Neon URL (required). Prefer non-pooler if you use transfers/sales txs
# DIRECT_URL     = Neon non-pooler URL (required for prisma migrate)
# AUTH_SECRET    = long random string (required — without it → /api/auth/error)
# AUTH_URL       = https://aramat-plus.vercel.app
# NEXTAUTH_URL   = https://aramat-plus.vercel.app
# BLOB_READ_WRITE_TOKEN = from Vercel → Storage → Blob (create public store, connect project)
#   Required on Vercel: serverless FS is read-only — product photos need Blob.
#   Local `npm run dev` works without it (writes to public/uploads/products/).
# Then Redeploy.

# App
NEXT_PUBLIC_APP_NAME="Aromat Plus"
