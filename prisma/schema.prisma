generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: set DIRECT_URL to the *non-pooler* host. Migrations + interactive
  // $transaction need it; pooler URLs often cause P2028 "Transaction not found".
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  MANAGER
  SELLER
}

enum AccountingType {
  WEIGHT
  PIECE
}

/** STANDARD = aroma/goods; PACKAGING = empty bottle stock (PIECE). */
enum ProductKind {
  STANDARD
  PACKAGING
}

enum LocationType {
  WAREHOUSE
  STORE
}

/** How a batch entered stock (Stage 5 purchases vs transfer/return). */
enum BatchOrigin {
  PURCHASE
  TRANSFER
  RETURN
  INITIAL
  ADJUSTMENT
  OTHER
}

enum ExpensePeriodicity {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

/** Catalog reasons for customer returns (analytics-friendly). */
enum ReturnReasonCode {
  DEFECT
  SELLER_ERROR
  CUSTOMER_ERROR
  EXPIRED
  DAMAGED
  OTHER
}

/** Catalog reasons for write-offs. */
enum WriteOffReasonCode {
  SPOILED
  BROKEN
  TESTER
  STOLEN
  LOSS
  EXPIRED
  OTHER
}

enum StoreKind {
  BRANCH
  OWNER_DIRECT
}

enum StoreStatus {
  ACTIVE
  CLOSED
  INVENTORY
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  RETURNED
  PARTIAL_RETURN
}

enum DiscountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  LOW_STOCK
  DISCOUNT_REQUEST
  RETURN_REQUEST
  BATCH_EMPTY
  INVENTORY_DONE
  TRANSFER_DONE
  SYSTEM
}

// ─── Company (single-tenant now, multi later) ────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("TJS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  warehouses      Warehouse[]
  stores          Store[]
  categories      Category[]
  brands          Brand[]
  units           Unit[]
  productTypes    ProductType[]
  operationTypes  OperationType[]
  expenseTypes    ExpenseType[]
  products        Product[]
  suppliers       Supplier[]
  packagingSkus   PackagingSku[]
  settings        Setting[]
  giftRules       GiftRule[]
  reservations    Reservation[]
  discountRequests DiscountRequest[]
}

// ─── Packaging catalog (Block 4) — bottles are NOT aroma products ────────────

model PackagingSku {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  volumeMl    Decimal  @db.Decimal(14, 3)
  /// glass | plastic | … (empty string = unspecified)
  material    String   @default("glass")
  color       String   @default("")
  cap         String   @default("")
  skuCode     String?
  defaultCost Decimal? @db.Decimal(12, 4)
  isDefaultForVolume Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, volumeMl, material, color, cap])
  @@index([companyId, volumeMl])
  @@index([companyId, isActive])
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              Role      @default(SELLER)
  isActive          Boolean   @default(true)
  companyId         String
  storeId           String?
  lastLoginAt       DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  managedStores  Store[] @relation("StoreManager")
  costChanges    CostHistory[]

  priceChanges       PriceHistory[]
  transfers          Transfer[]           @relation("TransferCreator")
  sales              Sale[]
  saleDiscountApprovals Sale[]            @relation("SaleDiscountApprover")
  discountRequests   DiscountRequest[]    @relation("DiscountRequester")
  discountReviews    DiscountRequest[]    @relation("DiscountReviewer")
  returnRequests     SaleReturn[]         @relation("ReturnRequester")
  returnReviews      SaleReturn[]         @relation("ReturnReviewer")
  inventorySessions  InventorySession[]   @relation("InventoryCreator")
  inventoryApprovals InventorySession[]   @relation("InventoryApprover")
  reservationsCreated Reservation[]       @relation("ReservationCreator")
  notifications      Notification[]
  expenses           Expense[]
  activityLogs       ActivityLog[]
  batchesCreated     Batch[]              @relation("BatchCreator")

  @@index([companyId])
  @@index([storeId])
  @@index([role])
}

// ─── Locations ───────────────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  companyId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transfers Transfer[]

  @@index([companyId])
}

model Store {
  id              String      @id @default(cuid())
  name            String
  address         String?
  phone           String?
  workingHours    String?
  companyId       String
  kind            StoreKind   @default(BRANCH)
  status          StoreStatus @default(ACTIVE)
  isArchived      Boolean     @default(false)
  openedAt        DateTime?
  managerId       String?
  isActive        Boolean     @default(true)
  notifyLowStock  Boolean     @default(true)
  notifyRequests  Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager           User?              @relation("StoreManager", fields: [managerId], references: [id], onDelete: SetNull)
  users             User[]
  transfersIn       Transfer[]         @relation("TransferToStore")
  transfersOut      Transfer[]         @relation("TransferFromStore")
  sales             Sale[]
  inventorySessions InventorySession[]
  expenses          Expense[]
  reservations      Reservation[]
  discountRequests  DiscountRequest[]

  @@index([companyId])
  @@index([companyId, kind])
  @@index([status])
}

// ─── Reference data ──────────────────────────────────────────────────────────

model Category {
  id                 String   @id @default(cuid())
  name               String
  companyId          String
  lowStockThreshold  Decimal  @default(50) @db.Decimal(12, 3)
  isArchived         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Brand {
  id         String   @id @default(cuid())
  name       String
  companyId  String
  imageUrl   String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Unit {
  id        String   @id @default(cuid())
  name      String
  symbol    String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, symbol])
  @@index([companyId])
}

model ProductType {
  id        String   @id @default(cuid())
  name      String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model OperationType {
  id        String   @id @default(cuid())
  name      String
  code      String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
}

model ExpenseType {
  id        String   @id @default(cuid())
  name      String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  comment   String?
  isActive  Boolean  @default(true)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batches Batch[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, isActive])
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id             String         @id @default(cuid())
  name           String
  sku            String?
  barcode        String?
  description    String?
  companyId      String
  categoryId     String?
  brandId        String?
  unitId         String?
  productTypeId  String?
  accountingType AccountingType @default(PIECE)
  kind           ProductKind    @default(STANDARD)
  packagingSkuId String?
  salePrice      Decimal        @db.Decimal(12, 2)
  /// Справочная / плановая себестоимость за единицу (мл или шт). Реальная с/с — на Batch.
  defaultCostPerUnit Decimal?   @db.Decimal(12, 2)
  minStock       Decimal        @default(0) @db.Decimal(14, 3)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand        Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit         Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  productType  ProductType?  @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  packagingSku PackagingSku? @relation(fields: [packagingSkuId], references: [id], onDelete: SetNull)

  variants      ProductVariant[]
  batches       Batch[]
  stockBalances StockBalance[]
  priceHistory  PriceHistory[]
  costHistory   CostHistory[]
  transferItems TransferItem[]
  saleItems     SaleItem[]
  packagingSaleItems SaleItem[] @relation("SaleItemPackaging")
  giftRulesAsGift GiftRule[] @relation("GiftProduct")
  reservationItems ReservationItem[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, kind])
  @@index([categoryId])
  @@index([brandId])
  @@index([packagingSkuId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  oldPrice    Decimal  @db.Decimal(12, 2)
  newPrice    Decimal  @db.Decimal(12, 2)
  reason      String?
  changedById String
  createdAt   DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@index([productId, createdAt])
}

/** Planned / default cost changes (Batch.costPerUnit stays the true FIFO cost). */
model CostHistory {
  id          String   @id @default(cuid())
  productId   String
  oldCost     Decimal? @db.Decimal(12, 2)
  newCost     Decimal? @db.Decimal(12, 2)
  reason      String?
  changedById String
  createdAt   DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@index([productId, createdAt])
}

// ─── Batches & Stock ─────────────────────────────────────────────────────────

model Batch {
  id              String       @id @default(cuid())
  productId       String
  locationType    LocationType
  locationId      String
  /// Current remaining qty (FIFO decreases this).
  quantity        Decimal      @db.Decimal(14, 3)
  /// Qty at receipt — never decreases; used for purchase history / KPIs.
  initialQuantity Decimal      @db.Decimal(14, 3)
  costPerUnit     Decimal      @db.Decimal(12, 4)
  receivedAt      DateTime     @default(now())
  notes           String?
  transferItemId  String?
  origin          BatchOrigin  @default(PURCHASE)
  supplierId      String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("BatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  transferItems TransferItem[] @relation("SourceBatch")
  saleItems     SaleItem[]

  @@index([productId, locationType, locationId, receivedAt])
  @@index([locationType, locationId])
  @@index([supplierId])
  @@index([createdById])
  @@index([origin, receivedAt])
}

model StockBalance {
  id           String       @id @default(cuid())
  productId    String
  locationType LocationType
  locationId   String
  quantity     Decimal      @default(0) @db.Decimal(14, 3)
  updatedAt    DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationType, locationId])
  @@index([locationType, locationId])
}

// ─── Transfers ───────────────────────────────────────────────────────────────

model Transfer {
  id              String         @id @default(cuid())
  fromWarehouseId String?
  fromStoreId     String?
  toStoreId       String
  createdById     String
  status          TransferStatus @default(COMPLETED)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fromWarehouse Warehouse?     @relation(fields: [fromWarehouseId], references: [id])
  fromStore     Store?         @relation("TransferFromStore", fields: [fromStoreId], references: [id])
  toStore       Store          @relation("TransferToStore", fields: [toStoreId], references: [id])
  createdBy     User           @relation("TransferCreator", fields: [createdById], references: [id])
  items         TransferItem[]

  @@index([fromWarehouseId])
  @@index([fromStoreId])
  @@index([toStoreId])
  @@index([createdAt])
}

model TransferItem {
  id            String  @id @default(cuid())
  transferId    String
  productId     String
  quantity      Decimal @db.Decimal(14, 3)
  sourceBatchId String?
  costPerUnit   Decimal @db.Decimal(12, 4)

  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  sourceBatch Batch?   @relation("SourceBatch", fields: [sourceBatchId], references: [id])

  @@index([transferId])
  @@index([productId])
}

// ─── Sales (schema ready, API later) ─────────────────────────────────────────

model Sale {
  id             String     @id @default(cuid())
  storeId        String
  sellerId       String
  status         SaleStatus @default(COMPLETED)
  subtotal       Decimal    @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @db.Decimal(12, 2)
  paymentMethod  String     @default("CASH")
  notes          String?
  /// Linked approved discount request (seller cart → owner → sale).
  discountRequestId   String?   @unique
  discountApprovedById String?
  discountApprovedAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  store            Store             @relation(fields: [storeId], references: [id])
  seller           User              @relation(fields: [sellerId], references: [id])
  items            SaleItem[]
  discountRequests DiscountRequest[] @relation("DiscountSaleLink")
  appliedDiscount  DiscountRequest?  @relation("DiscountAppliedToSale", fields: [discountRequestId], references: [id], onDelete: SetNull)
  discountApprover User?             @relation("SaleDiscountApprover", fields: [discountApprovedById], references: [id], onDelete: SetNull)
  returns          SaleReturn[]
  reservation      Reservation?

  @@index([storeId, createdAt])
  @@index([sellerId])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  batchId     String?
  quantity    Decimal @db.Decimal(14, 3)
  salePrice   Decimal @db.Decimal(12, 2)
  costPerUnit Decimal @db.Decimal(12, 4)
  isGift      Boolean @default(false)
  /// Decant line: aroma (WEIGHT) + empty bottle (PACKAGING Product).
  isDecant             Boolean  @default(false)
  packagingProductId   String?
  packagingQuantity    Decimal? @db.Decimal(14, 3)
  packagingCostPerUnit Decimal? @db.Decimal(12, 4)

  sale               Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id])
  packagingProduct   Product? @relation("SaleItemPackaging", fields: [packagingProductId], references: [id])
  batch              Batch?   @relation(fields: [batchId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([packagingProductId])
}

// ─── Stock reservations (available qty = physical − ACTIVE) ──────────────────

model Reservation {
  id           String            @id @default(cuid())
  companyId    String
  storeId      String
  locationType LocationType
  locationId   String
  status       ReservationStatus @default(ACTIVE)
  expiresAt    DateTime
  createdById  String
  saleId       String?           @unique
  customerNote String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store     Store              @relation(fields: [storeId], references: [id])
  createdBy User               @relation("ReservationCreator", fields: [createdById], references: [id])
  sale      Sale?              @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items     ReservationItem[]

  @@index([companyId, status, expiresAt])
  @@index([storeId, status])
  @@index([locationType, locationId, status])
  @@index([createdById])
}

model ReservationItem {
  id            String  @id @default(cuid())
  reservationId String
  productId     String
  quantity      Decimal @db.Decimal(14, 3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([reservationId])
  @@index([productId])
}

// ─── Discounts & Gifts ───────────────────────────────────────────────────────

model DiscountRequest {
  id             String                @id @default(cuid())
  companyId      String
  storeId        String?
  saleId         String?
  requesterId    String
  reviewerId     String?
  /// Cart subtotal at request time (before discount).
  originalAmount Decimal               @db.Decimal(12, 2)
  amount         Decimal               @db.Decimal(12, 2)
  percent        Decimal?              @db.Decimal(5, 2)
  status         DiscountRequestStatus @default(PENDING)
  reason         String?
  reviewNote     String?
  /// Snapshot of cart lines: [{ productId, quantity, salePrice }]
  cartSnapshot   Json?
  createdAt      DateTime              @default(now())
  reviewedAt     DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store     Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  sale      Sale?   @relation("DiscountSaleLink", fields: [saleId], references: [id], onDelete: SetNull)
  appliedSale Sale? @relation("DiscountAppliedToSale")
  requester User    @relation("DiscountRequester", fields: [requesterId], references: [id])
  reviewer  User?   @relation("DiscountReviewer", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([requesterId])
  @@index([companyId, status])
  @@index([storeId])
}

model GiftRule {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  minQuantity     Decimal? @db.Decimal(14, 3)
  minAmount       Decimal? @db.Decimal(12, 2)
  giftProductId   String
  giftQuantity    Decimal  @default(1) @db.Decimal(14, 3)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  giftProduct Product @relation("GiftProduct", fields: [giftProductId], references: [id])

  @@index([companyId])
}

// ─── Returns ─────────────────────────────────────────────────────────────────

model SaleReturn {
  id          String            @id @default(cuid())
  saleId      String
  requesterId String
  reviewerId  String?
  status      ReturnStatus      @default(PENDING)
  reason      String?
  reasonCode  ReturnReasonCode?
  reviewNote  String?
  createdAt   DateTime          @default(now())
  reviewedAt  DateTime?

  sale      Sale @relation(fields: [saleId], references: [id])
  requester User @relation("ReturnRequester", fields: [requesterId], references: [id])
  reviewer  User? @relation("ReturnReviewer", fields: [reviewerId], references: [id])
  items     SaleReturnItem[]

  @@map("returns")
  @@index([status])
  @@index([saleId])
}

/** Partial return lines — qty to restore (≤ original SaleItem.quantity). */
model SaleReturnItem {
  id           String  @id @default(cuid())
  returnId     String
  saleItemId   String
  productId    String
  quantity     Decimal @db.Decimal(14, 3)
  costPerUnit  Decimal @db.Decimal(12, 4)
  salePrice    Decimal @db.Decimal(12, 2)
  /// Restore bottle stock only when sealed/unused packaging returned.
  packagingReturned Boolean @default(false)

  return SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([saleItemId])
}

// ─── Inventory / Revision ────────────────────────────────────────────────────

model InventorySession {
  id          String          @id @default(cuid())
  storeId     String
  createdById String
  approvedById String?
  status      InventoryStatus @default(IN_PROGRESS)
  comment     String?
  createdAt   DateTime        @default(now())
  completedAt DateTime?

  store      Store           @relation(fields: [storeId], references: [id])
  createdBy  User            @relation("InventoryCreator", fields: [createdById], references: [id])
  approvedBy User?           @relation("InventoryApprover", fields: [approvedById], references: [id])
  items      InventoryItem[]

  @@index([storeId])
  @@index([createdAt])
}

model InventoryItem {
  id                  String  @id @default(cuid())
  sessionId           String
  productId           String
  expectedQty         Decimal @db.Decimal(14, 3)
  countedQty          Decimal @db.Decimal(14, 3)
  difference          Decimal @db.Decimal(14, 3)
  discrepancyReason   String?

  session InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ─── Notifications, Expenses, Logs, Settings ─────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  entityType String?
  entityId   String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Expense {
  id            String             @id @default(cuid())
  storeId       String?
  expenseTypeId String
  amount        Decimal            @db.Decimal(12, 2)
  description   String?
  createdById   String
  /** Legacy / ONCE day stamp; for recurring also mirrors startsAt. */
  incurredAt    DateTime           @default(now())
  periodicity   ExpensePeriodicity @default(ONCE)
  /** Inclusive start of this rate (recurring) or day of one-shot. */
  startsAt      DateTime           @default(now())
  /** Inclusive end; null = open-ended recurring. */
  endsAt        DateTime?
  createdAt     DateTime           @default(now())

  store       Store?      @relation(fields: [storeId], references: [id])
  expenseType ExpenseType @relation(fields: [expenseTypeId], references: [id])
  createdBy   User        @relation(fields: [createdById], references: [id])

  @@index([storeId, incurredAt])
  @@index([storeId, startsAt, endsAt])
  @@index([periodicity, startsAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  companyId  String?
  action     String
  entityType String
  entityId   String?
  comment    String?
  metadata   Json?
  ip         String?
  userAgent  String?
  result     String?  // SUCCESS | FAIL
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([companyId, createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  companyId String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}
